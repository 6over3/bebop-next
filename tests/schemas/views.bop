mut struct Point {
    x: int32;
    label: string;
}

message Child {
    value(1): string;
}

union Payload {
    Point(1): Point;
    Child(2): Child;
}

message Envelope {
    origin(1): Point;
    payload(9): Payload;
    children(33): Child[];
    child(129): Child;
    lookup(200): map[string, Child];
    sequences(201): map[string, int32[]];
}

enum State : uint16 {
    IDLE = 0;
    ACTIVE = 1;
}

mut struct FixedRecord {
    id: uint64;
    samples: float32[3];
    enabled: bool;
    state: State;
}

mut struct FixedCollections {
    records: FixedRecord[];
    samples: float32[4];
    values: uint32[];
}
