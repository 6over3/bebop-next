package numeric

import "bebop/decorators.bop"

const int8 MIN_I8 = -128;
const byte MAX_U8 = 255;
const int16 MIN_I16 = -32768;
const uint16 MAX_U16 = 65535;
const int32 MIN_I32 = -2147483648;
const uint32 MAX_U32 = 4294967295;
const int64 MIN_I64 = -9223372036854775808;
const int64 MAX_I64 = 9223372036854775807;
const uint64 MAX_U64 = 18446744073709551615;
const int128 MIN_I128 = -170141183460469231731687303715884105728;
const int128 NEG_I128 = -18446744073709551617;
const int128 MAX_I128 = 170141183460469231731687303715884105727;
const uint128 MAX_U128 = 340282366920938463463374607431768211455;

const float64 POSITIVE_INFINITY = inf;
const float64 NEGATIVE_INFINITY = -inf;
const float64 NOT_A_NUMBER = nan;
const float64 PRECISE = 1.0000000000000002;
const float64 NEGATIVE_ZERO = -0.0;

@flags
enum BitExpressions : uint32 {
    NONE = 0;
    READ = 1;
    WRITE = 2;
    ALL = ~NONE;
    LEGACY = ~0 - 1;
    GROUP = (READ | WRITE) << 2;
    LEFT = 1 << 1 + 2;
    RIGHT = 32 >> 1 + 1;
}

@flags
enum SignedExpressions : int64 {
    ZERO = 0;
    NEGATIVE = -8;
    HALF = NEGATIVE >> 1;
    ALL = ~0;
    GROUP = -(-5 + 2);
    MAX = 9223372036854775807;
    MIN = -9223372036854775808;
    RECOVERED_MAX = MAX + 1 - 1;
    RECOVERED_MIN = MIN - 1 + 1;
}

@flags
enum WideExpressions : uint64 {
    ZERO = 0;
    MAX = 18446744073709551615;
    RECOVERED = MAX + 1 - 1;
    BORROW = (MAX + 1) - MAX;
}

mut struct ExpressionValues {
    flags: BitExpressions;
    delta: SignedExpressions;
}
