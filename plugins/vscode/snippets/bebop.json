{
	"Struct": {
		"prefix": ["struct", "st"],
		"body": [
			"struct ${1:Name} {",
			"\t${2:field}: ${3:type};",
			"}"
		],
		"description": "Define a struct with positional fields"
	},
	"Mutable Struct": {
		"prefix": ["mut", "mst"],
		"body": [
			"mut struct ${1:Name} {",
			"\t${2:field}: ${3:type};",
			"}"
		],
		"description": "Define a mutable struct"
	},
	"Message": {
		"prefix": ["message", "msg"],
		"body": [
			"message ${1:Name} {",
			"\t${2:field}(${3:1}): ${4:type};",
			"}"
		],
		"description": "Define a message with tagged fields"
	},
	"Message Field": {
		"prefix": ["field", "mf"],
		"body": "${1:field}(${2:1}): ${3:type};",
		"description": "Add a tagged field to a message"
	},
	"Enum": {
		"prefix": ["enum", "en"],
		"body": [
			"enum ${1:Name} {",
			"\t${2:UNKNOWN} = 0;",
			"}"
		],
		"description": "Define an enum"
	},
	"Enum with Base Type": {
		"prefix": ["enumbase", "enb"],
		"body": [
			"enum ${1:Name} : ${2:uint8} {",
			"\t${3:UNKNOWN} = 0;",
			"}"
		],
		"description": "Define an enum with explicit base type"
	},
	"Flags Enum": {
		"prefix": ["flags", "fl"],
		"body": [
			"@flags",
			"enum ${1:Name} : ${2:uint8} {",
			"\tNONE = 0;",
			"\t${3:READ} = 1;",
			"\t${4:WRITE} = 1 << 1;",
			"\t${5:EXECUTE} = 1 << 2;",
			"}"
		],
		"description": "Define a bit flags enum (requires bebop/decorators.bop)"
	},
	"Union": {
		"prefix": ["union", "un"],
		"body": [
			"union ${1:Name} {",
			"\t${2:Variant}(${3:1}): {",
			"\t\t${4:field}: ${5:type};",
			"\t};",
			"}"
		],
		"description": "Define a discriminated union"
	},
	"Union Branch": {
		"prefix": ["branch", "ub"],
		"body": [
			"${1:Variant}(${2:1}): {",
			"\t${3:field}: ${4:type};",
			"};"
		],
		"description": "Add an inline struct branch to a union"
	},
	"Union Branch Reference": {
		"prefix": ["branchref", "ubr"],
		"body": "${1:Variant}(${2:1}): ${3:ExistingType};",
		"description": "Add a branch referencing an existing type"
	},
	"Service": {
		"prefix": ["service", "svc"],
		"body": [
			"service ${1:Name} {",
			"\t${2:Method}(${3:Request}): ${4:Response};",
			"}"
		],
		"description": "Define a service"
	},
	"Service Method": {
		"prefix": ["method", "rpc"],
		"body": "${1:Method}(${2:Request}): ${3:Response};",
		"description": "Add a unary method to a service"
	},
	"Service Stream Method": {
		"prefix": ["stream", "sm"],
		"body": "${1:Method}(stream ${2:Request}): stream ${3:Response};",
		"description": "Add a bidirectional streaming method"
	},
	"Const": {
		"prefix": ["const", "co"],
		"body": "const ${1:type} ${2:NAME} = ${3:value};",
		"description": "Define a constant"
	},
	"Const String": {
		"prefix": ["conststr", "cs"],
		"body": "const string ${1:NAME} = \"${2:value}\";",
		"description": "Define a string constant"
	},
	"Import": {
		"prefix": ["import", "imp"],
		"body": "import \"${1:path}\"",
		"description": "Import another schema file"
	},
	"Package": {
		"prefix": ["package", "pkg"],
		"body": "package ${1:name}",
		"description": "Declare the file's package namespace"
	},
	"Decorator": {
		"prefix": ["@", "dec"],
		"body": "@${1:decorator}",
		"description": "Apply a decorator"
	},
	"Deprecated": {
		"prefix": ["deprecated", "dep"],
		"body": "@deprecated(\"${1:reason}\")",
		"description": "Mark as deprecated (requires bebop/decorators.bop)"
	},
	"Decorator Definition": {
		"prefix": ["decorator", "decdef"],
		"body": [
			"#decorator(${1:name}) {",
			"\ttargets = ${2:FIELD}",
			"\tparam ${3:value}!: ${4:int32}",
			"\tvalidate [[",
			"\t\t$0",
			"\t]]",
			"}"
		],
		"description": "Define a custom decorator"
	},
	"Documentation": {
		"prefix": ["doc", "///"],
		"body": "/// ${1:Documentation}",
		"description": "Add documentation comment"
	},
	"Block Comment": {
		"prefix": ["comment", "/*"],
		"body": [
			"/*",
			" * ${1:Comment}",
			" */"
		],
		"description": "Add block comment"
	},
	"Edition": {
		"prefix": ["edition", "ed"],
		"body": "edition = \"${1:2026}\"",
		"description": "Set schema edition"
	},
	"Preamble": {
		"prefix": ["preamble", "header"],
		"body": [
			"edition = \"2026\"",
			"package ${1:name}",
			"",
			"import \"bebop/decorators.bop\"",
			"",
			"$0"
		],
		"description": "File preamble: edition, package, imports"
	},
	"Map Type": {
		"prefix": ["map"],
		"body": "map[${1:string}, ${2:type}]",
		"description": "Map type"
	},
	"Array Type": {
		"prefix": ["array", "arr"],
		"body": "${1:type}[]",
		"description": "Array type"
	},
	"Fixed Array Type": {
		"prefix": ["fixedarray", "farr"],
		"body": "${1:type}[${2:size}]",
		"description": "Fixed-size array type"
	},
	"Request/Response Pair": {
		"prefix": ["reqres", "rr"],
		"body": [
			"message ${1:Name}Request {",
			"\t${2:field}(1): ${3:type};",
			"}",
			"",
			"message ${1:Name}Response {",
			"\t${4:result}(1): ${5:type};",
			"}"
		],
		"description": "Create request/response message pair"
	},
	"CRUD Service": {
		"prefix": ["crud"],
		"body": [
			"message ${1:Entity} {",
			"\tid(1): uuid;",
			"\t${2:field}(2): ${3:type};",
			"}",
			"",
			"message Create${1:Entity}Request {",
			"\t${2:field}(1): ${3:type};",
			"}",
			"",
			"message Get${1:Entity}Request {",
			"\tid(1): uuid;",
			"}",
			"",
			"message Update${1:Entity}Request {",
			"\tid(1): uuid;",
			"\t${2:field}(2): ${3:type};",
			"}",
			"",
			"message Delete${1:Entity}Request {",
			"\tid(1): uuid;",
			"}",
			"",
			"message ${1:Entity}Response {",
			"\tentity(1): ${1:Entity};",
			"}",
			"",
			"service ${1:Entity}Service {",
			"\tCreate(Create${1:Entity}Request): ${1:Entity}Response;",
			"\tGet(Get${1:Entity}Request): ${1:Entity}Response;",
			"\tUpdate(Update${1:Entity}Request): ${1:Entity}Response;",
			"\tDelete(Delete${1:Entity}Request): ${1:Entity}Response;",
			"}"
		],
		"description": "Generate CRUD service boilerplate"
	}
}
