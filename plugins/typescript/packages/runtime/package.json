{
  "name": "@bebop/runtime",
  "version": "2026.0.0-alpha.6",
  "description": "Tree-shakeable runtime primitives for Bebop-generated TypeScript.",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./any": { "types": "./dist/any.d.ts", "import": "./dist/any.js" },
    "./bfloat16": { "types": "./dist/bfloat16.d.ts", "import": "./dist/bfloat16.js" },
    "./codec": { "types": "./dist/codec.d.ts", "import": "./dist/codec.js" },
    "./empty": { "types": "./dist/empty.d.ts", "import": "./dist/empty.js" },
    "./error": { "types": "./dist/error.d.ts", "import": "./dist/error.js" },
    "./json": { "types": "./dist/json.bb.d.ts", "import": "./dist/json.bb.js" },
    "./message": { "types": "./dist/message.d.ts", "import": "./dist/message.js" },
    "./reflection": { "types": "./dist/reflection.d.ts", "import": "./dist/reflection.js" },
    "./rpc": { "types": "./dist/rpc/index.d.ts", "import": "./dist/rpc/index.js" },
    "./rpc/protocol": { "types": "./dist/rpc.bb.d.ts", "import": "./dist/rpc.bb.js" },
    "./rpc/batch": { "types": "./dist/rpc/batch.d.ts", "import": "./dist/rpc/batch.js" },
    "./rpc/buffered-payload": { "types": "./dist/rpc/buffered-payload.d.ts", "import": "./dist/rpc/buffered-payload.js" },
    "./rpc/channel": { "types": "./dist/rpc/channel.d.ts", "import": "./dist/rpc/channel.js" },
    "./rpc/context": { "types": "./dist/rpc/context.d.ts", "import": "./dist/rpc/context.js" },
    "./rpc/error": { "types": "./dist/rpc/error.d.ts", "import": "./dist/rpc/error.js" },
    "./rpc/frame": { "types": "./dist/rpc/frame.d.ts", "import": "./dist/rpc/frame.js" },
    "./rpc/future": { "types": "./dist/rpc/future.d.ts", "import": "./dist/rpc/future.js" },
    "./rpc/future-storage": { "types": "./dist/rpc/future-storage.d.ts", "import": "./dist/rpc/future-storage.js" },
    "./rpc/payload": { "types": "./dist/rpc/payload.d.ts", "import": "./dist/rpc/payload.js" },
    "./rpc/router": { "types": "./dist/rpc/router.d.ts", "import": "./dist/rpc/router.js" },
    "./rpc/service": { "types": "./dist/rpc/service.d.ts", "import": "./dist/rpc/service.js" },
    "./temporal": { "types": "./dist/temporal.d.ts", "import": "./dist/temporal.js" },
    "./uuid": { "types": "./dist/uuid.d.ts", "import": "./dist/uuid.js" },
    "./view": { "types": "./dist/view.d.ts", "import": "./dist/view.js" },
    "./wire": { "types": "./dist/wire.d.ts", "import": "./dist/wire.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/6over3/bebop.git",
    "directory": "plugins/typescript/packages/runtime"
  },
  "keywords": ["bebop", "serialization", "rpc", "typescript"],
  "license": "Apache-2.0"
}
